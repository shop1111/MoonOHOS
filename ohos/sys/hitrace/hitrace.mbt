#borrow(callback)
extern "C" fn raw_OH_HiTrace_RegisterTraceListener(
  callback_tramp : FuncRef[((Bool) -> Unit, Int32) -> Unit],
  callback : (Bool) -> Unit,
  callback_slot : Int32,
) -> Int32 = "moonohos_sys_OH_HiTrace_RegisterTraceListener"

///|
/// `OH_HiTrace_RegisterTraceListener` from `hitrace/trace.h` (`libhitrace_ndk.z.so`).
/// The callback may run on an SDK thread; MoonOHOS enters the MoonBit gate first.
pub fn register_trace_listener(
  callback : (Bool) -> Unit,
) -> Int32 raise SysError {
  let callback_slot = raw_slot_OH_HiTrace_RegisterTraceListener_0()
  if callback_slot < 0 {
    raise Failed(
      "OH_HiTrace_RegisterTraceListener", "all 8 callback slots are in use", -1,
    )
  }
  let value = raw_OH_HiTrace_RegisterTraceListener(
    fn(moonohos_cb, moonohos_a0) { moonohos_cb(moonohos_a0 != 0) },
    callback,
    callback_slot,
  )
  value
}

