  tile_x : OH_Drawing_TileMode,
  tile_y : OH_Drawing_TileMode,
  sampling_options : OH_Drawing_SamplingOptions,
  matrix : OH_Drawing_Matrix,
) -> OH_Drawing_ShaderEffect? raise SysError {
  if !pixel_map.is_live() {
    raise Closed(
      "OH_Drawing_ShaderEffectCreatePixelMapShader: pixel_map was destroyed",
    )
  }
  if !sampling_options.is_live() {
    raise Closed(
      "OH_Drawing_ShaderEffectCreatePixelMapShader: sampling_options was destroyed",
    )
  }
  if !matrix.is_live() {
    raise Closed(
      "OH_Drawing_ShaderEffectCreatePixelMapShader: matrix was destroyed",
    )
  }
  let object = raw_OH_Drawing_ShaderEffectCreatePixelMapShader(
    pixel_map,
    tile_x.to_raw(),
    tile_y.to_raw(),
    sampling_options,
    matrix,
  )
  if object.is_live() {
    Some(object)
  } else {
    None
  }
}

///|
#borrow(colors, pos, matrix)
extern "C" fn raw_OH_Drawing_ShaderEffectCreateTwoPointConicalGradient(
  start_pt_x : Float,
  start_pt_y : Float,
  start_radius : Float,
  end_pt_x : Float,
  end_pt_y : Float,
  end_radius : Float,
  colors : FixedArray[UInt32],
  pos : FixedArray[Float],
  colors_count : Int32,
  tile_mode : Int32,
  matrix : OH_Drawing_Matrix,
) -> OH_Drawing_ShaderEffect = "moonohos_sys_OH_Drawing_ShaderEffectCreateTwoPointConicalGradient"

///|
/// `OH_Drawing_ShaderEffectCreateTwoPointConicalGradient` from `native_drawing/drawing_shader_effect.h` (`libnative_drawing.so`).
pub fn shader_effect_create_two_point_conical_gradient(
  start_pt : OH_Drawing_Point2D,
  start_radius : Float,
  end_pt : OH_Drawing_Point2D,
  end_radius : Float,
  colors : FixedArray[UInt32],
  pos : FixedArray[Float],
  tile_mode : OH_Drawing_TileMode,
  matrix : OH_Drawing_Matrix,
) -> OH_Drawing_ShaderEffect? raise SysError {
  guard pos.length() == colors.length() else {
    abort(
      "OH_Drawing_ShaderEffectCreateTwoPointConicalGradient: pos and colors must have the same length",
    )
  }
  if !matrix.is_live() {
    raise Closed(
      "OH_Drawing_ShaderEffectCreateTwoPointConicalGradient: matrix was destroyed",
    )
  }
  let object = raw_OH_Drawing_ShaderEffectCreateTwoPointConicalGradient(
    start_pt.x,
    start_pt.y,
    start_radius,
    end_pt.x,
    end_pt.y,
    end_radius,
    colors,
    pos,
    colors.length(),
    tile_mode.to_raw(),
    matrix,
  )
  if object.is_live() {
    Some(object)
  } else {
    None
  }
}

///|
#borrow(dst, src)
extern "C" fn raw_OH_Drawing_ShaderEffectCreateCompose(
  dst : OH_Drawing_ShaderEffect,
  src : OH_Drawing_ShaderEffect,
  mode : Int32,
) -> OH_Drawing_ShaderEffect = "moonohos_sys_OH_Drawing_ShaderEffectCreateCompose"

///|
/// `OH_Drawing_ShaderEffectCreateCompose` from `native_drawing/drawing_shader_effect.h` (`libnative_drawing.so`).
pub fn shader_effect_create_compose(
  dst : OH_Drawing_ShaderEffect,
  src : OH_Drawing_ShaderEffect,
  mode : OH_Drawing_BlendMode,
) -> OH_Drawing_ShaderEffect? raise SysError {
  if !dst.is_live() {
    raise Closed("OH_Drawing_ShaderEffectCreateCompose: dst was destroyed")
  }
  if !src.is_live() {
    raise Closed("OH_Drawing_ShaderEffectCreateCompose: src was destroyed")
  }
  let object = raw_OH_Drawing_ShaderEffectCreateCompose(dst, src, mode.to_raw())
  if object.is_live() {
    Some(object)
  } else {
    None
  }
}

///|
#borrow(shader_effect)
extern "C" fn raw_OH_Drawing_ShaderEffectDestroy(
  shader_effect : OH_Drawing_ShaderEffect,
) -> Unit = "moonohos_sys_OH_Drawing_ShaderEffectDestroy"

///|
/// `OH_Drawing_ShaderEffectDestroy` from `native_drawing/drawing_shader_effect.h` (`libnative_drawing.so`).
pub fn shader_effect_destroy(
  shader_effect : OH_Drawing_ShaderEffect,
) -> Unit raise SysError {
  if !shader_effect.is_live() {
    raise Closed("OH_Drawing_ShaderEffectDestroy: shader_effect was destroyed")
  }
  raw_OH_Drawing_ShaderEffectDestroy(shader_effect)
}
