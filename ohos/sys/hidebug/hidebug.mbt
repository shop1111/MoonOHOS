///|
#borrow(file_name)
extern "C" fn raw_OH_HiDebug_StartAppTraceCapture(
  flag : Int32,
  tags : UInt64,
  limit_size : UInt32,
  file_name : Bytes,
  file_name_capacity : Int32,
) -> Int32 = "moonohos_sys_OH_HiDebug_StartAppTraceCapture"

///|
/// `OH_HiDebug_StartAppTraceCapture` from `hidebug/hidebug.h` (`libohhidebug.so`).
/// Raises `SysError` when the call returns a non-zero error code.
pub fn start_app_trace_capture(
  flag : HiDebug_TraceFlag,
  tags : UInt64,
  limit_size : UInt32,
) -> String raise SysError {
  let file_name = Bytes::make(256, b'\x00')
  let code = raw_OH_HiDebug_StartAppTraceCapture(
    flag.to_raw(),
    tags,
    limit_size,
    file_name,
    256,
  )
  if code != 0 {
    raise Failed(
      "OH_HiDebug_StartAppTraceCapture",
      HiDebug_ErrorCode::from_raw(code).c_name(),
      code,
    )
  }
  c_text(file_name)
}

