///|
#borrow(sync)
extern "C" fn raw_glIsSync(sync : C__GLsync) -> Int32 = "moonohos_sys_glIsSync"

///|
/// `glIsSync` from `GLES3/gl3.h` (`libGLESv3.so`).
pub fn is_sync(sync : C__GLsync) -> Int32 raise SysError {
  if !sync.is_live() {
    raise Closed("glIsSync: sync was destroyed")
  }
  let value = raw_glIsSync(sync)
  value
}

///|
#borrow(sync)
extern "C" fn raw_glDeleteSync(sync : C__GLsync) -> Unit = "moonohos_sys_glDeleteSync"

