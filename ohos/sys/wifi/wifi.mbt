    rx_link_speed: info_rx_link_speed[0],
    max_supported_tx_link_speed: info_max_supported_tx_link_speed[0],
    max_supported_rx_link_speed: info_max_supported_rx_link_speed[0],
    frequency: info_frequency[0],
    is_hidden: info_is_hidden[0] != 0,
    is_restricted: info_is_restricted[0] != 0,
    mac_type: info_mac_type[0],
    mac_address: c_text(info_mac_address),
    ip_address: info_ip_address[0],
    conn_state: OH_WifiConnState::from_raw(info_conn_state[0]),
    channel_width: OH_WifiChannelWidth::from_raw(info_channel_width[0]),
    wifi_standard: OH_WifiStandard::from_raw(info_wifi_standard[0]),
    supported_wifi_category: OH_WifiCategory::from_raw(
      info_supported_wifi_category[0],
    ),
    is_hi_link_network: info_is_hi_link_network[0] != 0,
    wifi_link_type: OH_WifiLinkType::from_raw(info_wifi_link_type[0]),
  }
}
