// Common OpenGL ES 3 constants (values from GLES3/gl3.h). The generated
// sys/gles package has the functions; C macros do not appear in the
// headers' AST, so the constants are listed here.

///|
pub const DEPTH_BUFFER_BIT : UInt32 = 0x00000100

///|
pub const STENCIL_BUFFER_BIT : UInt32 = 0x00000400

///|
pub const COLOR_BUFFER_BIT : UInt32 = 0x00004000

///|
pub const POINTS : UInt32 = 0x0000

///|
pub const LINES : UInt32 = 0x0001

///|
pub const LINE_STRIP : UInt32 = 0x0003

///|
pub const TRIANGLES : UInt32 = 0x0004

///|
pub const TRIANGLE_STRIP : UInt32 = 0x0005

///|
pub const TRIANGLE_FAN : UInt32 = 0x0006

///|
pub const BYTE : UInt32 = 0x1400

///|
pub const UNSIGNED_BYTE : UInt32 = 0x1401

///|
pub const UNSIGNED_SHORT : UInt32 = 0x1403

///|
pub const INT : UInt32 = 0x1404

///|
pub const UNSIGNED_INT : UInt32 = 0x1405

///|
pub const FLOAT : UInt32 = 0x1406

///|
pub const ARRAY_BUFFER : UInt32 = 0x8892

///|
pub const ELEMENT_ARRAY_BUFFER : UInt32 = 0x8893

///|
pub const STREAM_DRAW : UInt32 = 0x88E0

///|
pub const STATIC_DRAW : UInt32 = 0x88E4

///|
pub const DYNAMIC_DRAW : UInt32 = 0x88E8

///|
pub const FRAGMENT_SHADER : UInt32 = 0x8B30

///|
pub const VERTEX_SHADER : UInt32 = 0x8B31

///|
pub const COMPILE_STATUS : UInt32 = 0x8B81

///|
pub const LINK_STATUS : UInt32 = 0x8B82

///|
pub const BLEND : UInt32 = 0x0BE2

///|
pub const CULL_FACE : UInt32 = 0x0B44

///|
pub const DEPTH_TEST : UInt32 = 0x0B71

///|
pub const SCISSOR_TEST : UInt32 = 0x0C11

///|
pub const ZERO : UInt32 = 0

///|
pub const ONE : UInt32 = 1

///|
pub const SRC_ALPHA : UInt32 = 0x0302

///|
pub const ONE_MINUS_SRC_ALPHA : UInt32 = 0x0303

///|
pub const RGBA : UInt32 = 0x1908

///|
pub const TEXTURE_2D : UInt32 = 0x0DE1

///|
pub const TEXTURE0 : UInt32 = 0x84C0

///|
pub const VIEWPORT : UInt32 = 0x0BA2

///|
pub const MAX_TEXTURE_SIZE : UInt32 = 0x0D33

///|
pub const VENDOR : UInt32 = 0x1F00

///|
pub const RENDERER : UInt32 = 0x1F01

///|
pub const VERSION : UInt32 = 0x1F02

///|
pub const NO_ERROR : UInt32 = 0
