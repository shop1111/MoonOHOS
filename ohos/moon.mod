name = "shop1111/moonohos_ohos"

version = "0.9.0"

preferred_target = "native"

supported_targets = [ "native" ]

repository = "https://github.com/shop1111/MoonOHOS"

keywords = [
  "harmonyos",
  "hilog",
  "rawfile",
  "xcomponent",
  "opengl-es",
  "native-drawing",
  "sensor",
]

license = "Apache-2.0"

readme = "README.md"

description = "HarmonyOS platform packages for MoonOHOS native modules: HiLog, RawFile, task cancellation, XComponent surfaces with Native Drawing and OpenGL ES, and 16 sys/* packages generated from SDK headers (617 functions: display, sensors, drawing, GLES, battery, HiTrace, ...)."
