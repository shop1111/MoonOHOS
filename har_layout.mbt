///|
/// ArkTS facade re-exporting the native module and every declared interface.
pub fn har_facade(module_name : String, declarations : String) -> String {
  let names : Array[String] = []
  for line in declarations.split("\n") {
    let rest = if line.has_prefix("export interface ") {
      Some(line[17:].to_owned())
    } else if line.has_prefix("export type ") {
      Some(line[12:].to_owned())
    } else {
      None
    }
    if rest is Some(rest) {
      let name = rest.split(" ").head().unwrap_or("").to_owned()
      if identifier(name) && !names.contains(name) {
        names.push(name)
      }
    }
  }
  let library = "lib" + module_name + ".so"
  "// Generated by MoonOHOS " +
  moonohos_version() +
  " from types/" +
  "lib" +
  module_name +
  "/index.d.ts; regenerated by `moonohos har`.\nimport native from '" +
  library +
  "';\n\nexport { " +
  names.join(", ") +
  " } from '" +
  library +
  "';\nexport default native;\n"
}

///|
/// Checks a HAR module and points its native type dependency at the package.
pub fn har_package_manifest(
  text : String,
  module_name : String,
) -> String raise ConfigError {
  let json = @json.parse(text) catch {
    _ =>
      raise Invalid(
        "har: oh-package.json5 must be plain JSON (as created by moonohos init)",
      )
  }
  match json {
    Object(fields) => {
      match fields.get("main") {
        Some(String("Index.ets")) => ()
        _ => raise Invalid("har: oh-package.json5 main must be Index.ets")
      }
      let result = fields.copy()
      let dependencies : Map[String, Json] = match fields.get("dependencies") {
        Some(Object(values)) => values.copy()
        None => Map([])
        _ => raise Invalid("har: dependencies must be an object")
      }
      dependencies["lib" + module_name + ".so"] = Json(
        "file:./src/main/cpp/types/lib" + module_name,
      )
      result["dependencies"] = Json(dependencies)
      Json(result).stringify(indent=2) + "\n"
    }
    _ => raise Invalid("har: oh-package.json5 must be an object")
  }
}

///|
pub fn validate_har_module(module_json : String) -> Unit raise ConfigError {
  let compact = module_json
    .replace_all(old=" ", new="")
    .replace_all(old="\n", new="")
    .replace_all(old="\r", new="")
    .replace_all(old="\t", new="")
  if !compact.contains("\"type\":\"har\"") {
    raise Invalid("har: src/main/module.json5 must declare \"type\": \"har\"")
  }
}

///|
/// Provenance written next to the libraries inside the HAR module.
pub fn har_provenance(
  manifest : PackageManifest,
  manifest_sha256 : String,
) -> Json {
  {
    "moonohosVersion": moonohos_version(),
    "module": manifest.module_name,
    "packageVersion": manifest.version,
    "manifestSha256": manifest_sha256,
    "abis": Json(manifest.abis),
    "files": Json(
      manifest.files
      .filter(f => f.path.has_prefix("libs/") || f.path.has_prefix("types/"))
      .map(f => f.to_json()),
    ),
  }
}

///|
/// README written into every `moonohos build` output directory.
pub fn package_readme(native_module : String) -> String {
  let lib = "lib" + native_module + ".so"
  [
    "# MoonOHOS Native package: " + native_module,
    "",
    "Built by MoonOHOS " +
    moonohos_version() +
    ". `manifest.json` records the compiler, SDK API, exported functions and SHA-256 of every file; run `moonohos verify --out <this directory>` before distributing it.",
    "",
    "## Use it",
    "",
    "Recommended: `moonohos har --dist <this directory> --module <HAR module> --assemble --deveco <DevEco Studio>` puts the libraries, type package and an ArkTS facade into a HAR that any Stage app can depend on with `file:`.",
    "",
    "Manual: copy `libs/<abi>/" +
    lib +
    "` into `entry/libs/<abi>/`, copy `types/lib" +
    native_module +
    "` into `entry/src/main/cpp/types/`, declare it as a local dependency in `entry/oh-package.json5` and `import native from '" +
    lib +
    "'`. `cmake/MoonOHOS.cmake` is an optional imported target for C++ consumers; it does not package the library into a HAP.",
    "",
    "## Behaviour",
    "",
    "- Synchronous exports block the calling ArkTS thread; exports declared `\"async\": true` run on a Node-API worker thread, return a Promise and accept an optional `CancelToken`.",
    "- Exports declared `\"raises\": true` throw (or reject with) an error whose `code` is `ERR_MOONOHOS_BUSINESS`; the message is the MoonBit error's text.",
    "- Handles stay on the native side; call `close()` when done. Finalizers and environment cleanup release anything left open.",
    "- Int, Double, Bool, String (UTF-16 code units, NUL-safe), Bytes (Uint8Array), Array and records are copied. Conversions are limited to depth 32, 1,048,576 elements and 64 MiB; violations throw RangeError, wrong types throw TypeError.",
    "- A MoonBit `panic` or allocation failure terminates the process.",
    "",
    "## Licences",
    "",
    "Keep `NOTICE.NativeSDK.txt` and `NOTICE.MoonBit.txt` next to distributed libraries and add the licence of your own MoonBit code.",
    "",
  ].join("\n")
}
