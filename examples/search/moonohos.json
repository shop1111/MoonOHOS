{
  "version": 2,
  "module": "core",
  "package": "moonohos/search",
  "nativeModule": "moonsearch",
  "workspace": "moon.work",
  "handles": [{"name": "SearchIndex", "methods": ["search", "search_now", "stats", "term_idf"], "size": "index_bytes"}],
  "types": [
    {"name": "Hit", "fields": [
      {"name": "path", "type": "String"},
      {"name": "title", "type": "String"},
      {"name": "score", "type": "Double"},
      {"name": "snippet", "type": "String"}
    ]},
    {"name": "IndexStats", "fields": [
      {"name": "documents", "type": "Int"},
      {"name": "terms", "type": "Int"},
      {"name": "postings", "type": "Int"},
      {"name": "characters", "type": "Int"}
    ]}
  ],
  "functions": [
    {"name": "build_index", "params": [{"name": "resources", "type": "@rawfile.Manager"}, {"name": "dir", "type": "String"}], "return": "SearchIndex", "async": true, "raises": true},
    {"name": "build_index_reporting", "params": [{"name": "resources", "type": "@rawfile.Manager"}, {"name": "dir", "type": "String"}, {"name": "on_progress", "type": "(Int, Int) -> Unit"}], "return": "SearchIndex", "async": true, "raises": true},
    {"name": "search", "params": [{"name": "index", "type": "SearchIndex"}, {"name": "query", "type": "String"}, {"name": "limit", "type": "Int"}], "return": "Array[Hit]", "async": true},
    {"name": "search_now", "params": [{"name": "index", "type": "SearchIndex"}, {"name": "query", "type": "String"}, {"name": "limit", "type": "Int"}], "return": "Array[Hit]"},
    {"name": "stats", "params": [{"name": "index", "type": "SearchIndex"}], "return": "IndexStats"},
    {"name": "index_texts", "params": [{"name": "paths", "type": "Array[String]"}, {"name": "texts", "type": "Array[String]"}], "return": "SearchIndex", "async": true, "raises": true},
    {"name": "index_bytes", "params": [{"name": "index", "type": "SearchIndex"}], "return": "Int"},
    {"name": "platform_report", "params": [], "return": "Array[String]"},
    {"name": "platform_handles", "params": [], "return": "Array[String]"},
    {"name": "platform_listen_start", "params": [], "return": "Array[String]"},
    {"name": "platform_listen_stop", "params": [], "return": "Array[String]"},
    {"name": "surface_attach", "params": [{"name": "surface_id", "type": "String"}, {"name": "width", "type": "Int"}, {"name": "height", "type": "Int"}], "return": "String"},
    {"name": "surface_resize", "params": [{"name": "width", "type": "Int"}, {"name": "height", "type": "Int"}], "return": "String"},
    {"name": "surface_mode", "params": [{"name": "native", "type": "Bool"}], "return": "String"},
    {"name": "surface_touch", "params": [{"name": "x", "type": "Double"}, {"name": "y", "type": "Double"}], "return": "Int"},
    {"name": "surface_report", "params": [], "return": "String"},
    {"name": "surface_detach", "params": [], "return": "String"},
    {"name": "gl_attach", "params": [{"name": "surface_id", "type": "String"}], "return": "String"},
    {"name": "gl_report", "params": [], "return": "String"},
    {"name": "gl_detach", "params": [], "return": "String"},
    {"name": "term_idf", "params": [{"name": "index", "type": "SearchIndex"}, {"name": "query", "type": "String"}], "return": "FixedArray[Double]"}
  ]
}
